{
  "module": "MTakeoverInFlight.tla",
  "status": "refinement",
  "summary": "A session takeover while frames are in flight on the old connection (runtime.rs start_takeover, close, finish_close, pump_will_connects; net.rs Control::stop; owner.rs plan_frame_result): the old peer is cancelled and shut down before the new generation is bound, each of its accepted frames gets exactly one terminal result, a result ends only the generation it names, and nothing is written to a socket once its terminal reason is recorded or, for the old one, once the new generation is bound.",
  "issues": [648],
  "tests": ["mqttiumd/crates/mqttiumd-core/src/owner.rs", "mqttiumd/crates/mqttiumd/src/runtime_tests.rs", "mqttiumd/crates/mqttiumd/src/net.rs"],
  "replays": [{"file": "mqttiumd/crates/mqttiumd-core/src/owner.rs", "test": "a_failed_frame_ends_the_connection_of_its_session"}, {"file": "mqttiumd/crates/mqttiumd-core/src/owner.rs", "test": "qos1_complete_write_releases_once_partial_or_wrong_receipt_never_does"}, {"file": "mqttiumd/crates/mqttiumd/src/runtime_tests.rs", "test": "closing_qos0_without_collecting_written_retires_the_exact_attempt"}, {"file": "mqttiumd/crates/mqttiumd/src/runtime_tests.rs", "test": "takeover_waits_for_old_will_admission_and_old_close_cannot_publish_new_will"}, {"file": "mqttiumd/crates/mqttiumd/src/runtime_tests.rs", "test": "stale_puback_during_takeover_with_a_blocked_close_cannot_stop_other_connections"}, {"file": "mqttiumd/crates/mqttiumd/src/net.rs", "test": "cancellation_reports_every_accepted_output_frame"}],
  "not_replayed": "No test replays mut-record-before-shutdown (a write between the record of the terminal reason and the shutdown, the order Control::stop had before 967e95d), mut-cancel-without-shutdown or mut-open-without-waiting with a frame in flight; they need a chosen schedule of the core and reactor threads.",
  "configs": [
    {"config": "MTakeoverInFlight-safety.cfg", "expect": "pass", "invariants": ["TypeOK", "LanesFit", "OneResultPerFrame", "RetiredFramesResolved", "NoForeignEnd", "OldClosedBeforeNewBound", "OldSilentOnceNewBound", "ClosedIsShut", "RecordedIsShut", "NoWriteAfterRecord"]},
    {"config": "MTakeoverInFlight-safety-preserve.cfg", "expect": "pass", "invariants": ["TypeOK", "LanesFit", "OneResultPerFrame", "RetiredFramesResolved", "NoForeignEnd", "OldClosedBeforeNewBound", "OldSilentOnceNewBound", "ClosedIsShut", "RecordedIsShut", "NoWriteAfterRecord"]},
    {"config": "MTakeoverInFlight-liveness-frames.cfg", "expect": "pass", "property": "EveryFrameResolved"},
    {"config": "MTakeoverInFlight-liveness-takeover.cfg", "expect": "pass", "property": "TakeoverCompletes"},
    {"config": "MTakeoverInFlight-reach-late-old-result.cfg", "expect": "violation", "invariant": "NoLateOldResultWitness"},
    {"config": "MTakeoverInFlight-reach-frame-failed-by-close.cfg", "expect": "violation", "invariant": "NoFrameFailedByCloseWitness"},
    {"config": "MTakeoverInFlight-reach-mixed-outcome.cfg", "expect": "violation", "invariant": "NoMixedOutcomeWitness"},
    {"config": "MTakeoverInFlight-mut-no-generation-check.cfg", "expect": "violation", "invariant": "NoForeignEnd"},
    {"config": "MTakeoverInFlight-mut-leave-frames-at-close.cfg", "expect": "violation", "invariant": "RetiredFramesResolved"},
    {"config": "MTakeoverInFlight-mut-leave-frames-at-close-liveness.cfg", "expect": "liveness", "property": "EveryFrameResolved"},
    {"config": "MTakeoverInFlight-mut-open-without-waiting.cfg", "expect": "violation", "invariant": "OldClosedBeforeNewBound"},
    {"config": "MTakeoverInFlight-mut-open-without-waiting-write.cfg", "expect": "violation", "invariant": "OldSilentOnceNewBound"},
    {"config": "MTakeoverInFlight-mut-cancel-without-shutdown.cfg", "expect": "violation", "invariant": "OldSilentOnceNewBound"},
