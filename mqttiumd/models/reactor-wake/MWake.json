    {"config": "MWake-reach-coalesced-signal.cfg", "expect": "violation", "invariant": "NoCoalescedSignalWitness"},
    {"config": "MWake-mut-wake-before-publish.cfg", "expect": "violation", "invariant": "NoLostWakeup"},
    {"config": "MWake-mut-wake-before-publish-liveness.cfg", "expect": "liveness", "property": "EveryValueConsumed"},
