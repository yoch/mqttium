        "TypeOK",
        "ClosedResultsConsumed",
        "DeletedOnlyAfterClosure",
        "CreditsExact",
        "WithinWindow",
        "OriginMetadataBounded",
        "ClosureKnowledgeSound",
        "AdmissionIdentityUnique",
        "PublicationIdentityUnique",
        "PayloadIdentityUnique"
      ]
    },
    {
      "config": "MReceiptClosure-two-origins.cfg",
      "expect": "pass",
      "invariants": [
        "TypeOK",
        "ClosedResultsConsumed",
        "DeletedOnlyAfterClosure",
        "CreditsExact",
        "WithinWindow",
        "OriginMetadataBounded",
        "ClosureKnowledgeSound",
        "AdmissionIdentityUnique",
        "PublicationIdentityUnique",
        "PayloadIdentityUnique"
      ]
    },
    {
      "config": "MReceiptClosure-reach-gap.cfg",
      "expect": "violation",
      "invariant": "NoUnknownGap"
