    {
      "config": "MReceiptClosure-mut-old-publication.cfg",
      "expect": "violation",
      "invariant": "PublicationIdentityUnique"
    },
    {
      "config": "MReceiptClosure-mut-old-payload.cfg",
      "expect": "violation",
      "invariant": "PayloadIdentityUnique"
    },
    {
      "config": "MReceiptClosure-mut-double-credit.cfg",
      "expect": "violation",
      "invariant": "CreditsExact"
