diff --git a/mqttiumd/crates/mqttiumd-core/src/owner.rs b/mqttiumd/crates/mqttiumd-core/src/owner.rs
--- a/mqttiumd/crates/mqttiumd-core/src/owner.rs
+++ b/mqttiumd/crates/mqttiumd-core/src/owner.rs
@@ -3231,6 +3231,21 @@ impl Owner {
         }
         let waiting = self.slot_by_op.get(&operation).copied();
         let Some(index) = waiting else {
+            // MUTANT M5: a late unknown answer acknowledges the exchange again.
+            if let StoreReply::Outcome(StoreOutcome::PendingOrUnknown) = reply
+                && let Some(slot) = self.slots.values().find(|slot| {
+                    slot.admission
+                        .as_ref()
+                        .is_some_and(|known| known.operation == operation)
+                })
+            {
+                let frame = OutboundFrame::Pubrec {
+                    packet_id: slot.packet_id,
+                    reason: AckReason::Success,
+                };
+                self.plan_answer(slot, frame, draft)?;
+                return Ok(Change::Nothing);
+            }
             return self.plan_late_result(effect, operation, reply);
         };
         let slot = &self.slots[index];
