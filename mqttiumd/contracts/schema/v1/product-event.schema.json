{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "seq",
    "kind",
    "pid"
  ],
  "properties": {
    "format": {
      "const": "mqttiumd.product-event"
    },
    "schema_version": {
      "const": 1
    },
    "seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z_]{0,47}$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "connection": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incarnation",
        "epoch",
        "owner",
        "sequence"
      ],
      "properties": {
        "incarnation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "owner": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "point": {
      "enum": [
        "admission.prepared",
        "release.prepared",
        "admission.committed",
        "ack.receipt",
        "subscription.prepared",
        "claim.prepared",
        "finish.prepared",
        "claim.committed",
        "finish.committed",
        "consume.prepared",
        "consume.committed",
        "consume.emission",
        "receipt.close.prepared",
        "receipt.close.committed"
      ]
    },
    "command_kind": {
      "enum": [
        "Admission",
        "Release",
        "Subscriptions",
        "Claim",
        "Finish",
        "Consume",
        "ReceiptCollection"
      ]
    },
    "cause": {
      "enum": [
        "InvalidData",
        "LimitExceeded",
        "Unavailable",
        "Io",
        "AllocationFailed"
      ]
    },
    "phase": {
      "enum": [
        "Open",
        "Ledger",
        "Opening",
        "Lookup",
        "Snapshot",
        "Inspect",
        "Recovery",
        "Work",
        "Maintenance"
      ]
    },
    "details": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z_]{0,47}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        ]
      },
      "properties": {
        "returned_incarnation": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "returned_epoch": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "returned_owner": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "returned_through": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "returned_publication_through": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "returned_payload_through": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "puback": {
      "$ref": "#/$defs/puback_observation"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "command_kind"
        ],
        "properties": {
          "command_kind": {
            "const": "ReceiptCollection"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "puback_observed",
              "puback_ignored"
            ]
          }
        }
      },
      "then": {
        "required": [
          "puback",
          "details"
        ],
        "properties": {
          "details": {
            "required": [
              "authority"
            ],
            "properties": {
              "authority": {
                "const": "reader_dequeue"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "puback_target": {
      "description": "Immutable internal target selected after runtime reader-channel dequeue and decoding, before the owner-input queue. These identities are absent from the MQTT PUBACK wire packet. An older target is readable evidence, never automatically rebound to a current Packet Identifier occupant.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "claim_operation_id",
        "frame_effect_id"
      ],
      "properties": {
        "delivery_id": {
          "$ref": "primitives.schema.json#/$defs/delivery_id"
        },
        "claim_operation_id": {
          "$ref": "primitives.schema.json#/$defs/operation_id"
        },
        "frame_effect_id": {
          "$ref": "primitives.schema.json#/$defs/effect_id"
        }
      }
    },
    "puback_observation": {
      "description": "A validated PUBACK observed at runtime dequeue. The complete connection/number/reason/optional target survives internal delay or replay unchanged. Null is explicit no-target knowledge. Upstream reader-channel/socket bytes are outside this association boundary.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection",
        "packet_id",
        "reason_code",
        "target"
      ],
      "properties": {
        "connection": {
          "$ref": "primitives.schema.json#/$defs/connection_key"
        },
        "packet_id": {
          "$ref": "primitives.schema.json#/$defs/packet_id"
        },
        "reason_code": {
          "enum": [
            0,
            16,
            128,
            131,
            135,
            144,
            145,
            151,
            153
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/puback_target"
            }
          ]
        },
        "source_observation_sequence": {
          "$ref": "primitives.schema.json#/$defs/u64",
          "description": "Optional identifier of the original runtime-dequeue observation within this process, used to link a retained internal copy. This is not event.seq, a wire field, or a causal-order claim."
        }
      }
    }
  }
}
