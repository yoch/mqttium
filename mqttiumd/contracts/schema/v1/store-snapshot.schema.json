{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mqttiumd store snapshot",
  "description": "The durable state of a store at one checkpoint, as an independent read sees it (DEM-011, DEM-019). It is evidence for the oracle and never an input of the broker. A snapshot shows what the store holds, sound or not: its soundness is an assertion, not a condition of the format. Rows are in key order, so that two stores in the same state write the same bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "run_id",
    "checkpoint",
    "backend",
    "meta",
    "sessions",
    "route_table",
    "operations",
    "fences",
    "payloads",
    "publications",
    "obligations",
    "inbound_exchanges",
    "outbound",
    "account"
  ],
  "properties": {
    "format": {
      "const": "mqttiumd.store-snapshot"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "primitives.schema.json#/$defs/slug"
    },
    "checkpoint": {
      "$ref": "primitives.schema.json#/$defs/name"
    },
    "backend": {
      "enum": [
        "sim-store",
        "sqlite"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incarnation",
        "last_opened_epoch",
        "opened_by",
        "collected_through",
        "state_revision",
        "next_session"
      ],
      "properties": {
        "incarnation": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "last_opened_epoch": {
          "$ref": "primitives.schema.json#/$defs/u64",
          "description": "The open epoch; every earlier one is closed. \"0\": no epoch was ever opened."
        },
        "opened_by": {
          "description": "The attempt that opened the last epoch: its start-up nonce and its ticket. Null while no epoch is open.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "startup_hex",
                "ticket"
              ],
              "properties": {
                "startup_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "minLength": 32,
                  "maxLength": 32
                },
                "ticket": {
                  "$ref": "primitives.schema.json#/$defs/u64"
                }
              }
            }
          ]
        },
        "collected_through": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "state_revision": {
          "$ref": "primitives.schema.json#/$defs/u64",
          "description": "Advances at every commit; the frontier a recovery cursor names."
        },
        "next_session": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "sessions": {
      "description": "Sessions, by SessionId.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "client_id_hex",
          "revision",
          "state"
        ],
        "properties": {
          "session": {
            "$ref": "primitives.schema.json#/$defs/u64"
          },
          "client_id_hex": {
            "$ref": "primitives.schema.json#/$defs/hex_bytes"
          },
          "revision": {
            "$ref": "primitives.schema.json#/$defs/u64"
          },
          "state": {
            "description": "A deleted session stays, terminal: its identity is never reused.",
            "enum": [
              "Active",
              "Terminal"
            ]
          }
        }
      },
      "maxItems": 65536
    },
    "route_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "routes"
      ],
      "properties": {
        "revision": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "routes": {
          "description": "Exact-topic routes, by topic bytes.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic_hex",
              "targets"
            ],
            "properties": {
              "topic_hex": {
                "$ref": "primitives.schema.json#/$defs/hex_bytes"
              },
              "targets": {
                "description": "In the order they were added.",
                "type": "array",
                "maxItems": 65535,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "session",
                    "qos"
                  ],
                  "properties": {
                    "session": {
                      "$ref": "primitives.schema.json#/$defs/u64"
                    },
                    "qos": {
                      "$ref": "primitives.schema.json#/$defs/qos"
                    }
                  }
                }
              }
            }
          },
          "maxItems": 65536
        }
      }
    },
    "operations": {
      "description": "Receipts: operations the store decided, by OperationId. A certain rejection is a receipt too.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "recipe_hex",
          "decision"
        ],
        "properties": {
          "operation_id": {
            "$ref": "primitives.schema.json#/$defs/operation_id"
          },
          "recipe_hex": {
            "$ref": "primitives.schema.json#/$defs/hex_bytes",
            "description": "The exact canonical bytes of the recipe (DEM-009). Its kind byte says which command it is."
          },
          "decision": {
            "description": "The terminal decision of the receipt, with its content. An unknown outcome is not a durable fact.",
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "Committed",
                  "RejectedCertain"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "Committed"
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "facts"
                  ],
                  "properties": {
                    "kind": {
                      "const": "Committed"
                    },
                    "facts": {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "PublicationAdmitted",
                            "InboundReleased",
                            "SubscriptionsChanged",
                            "DeliveryClaimed",
                            "DeliveryFinished"
                          ]
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "required": [
                              "kind"
                            ],
                            "properties": {
                              "kind": {
                                "const": "PublicationAdmitted"
                              }
                            }
                          },
                          "then": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "publication_id",
                              "exchange"
                            ],
                            "properties": {
                              "kind": {
                                "const": "PublicationAdmitted"
                              },
                              "publication_id": {
                                "$ref": "primitives.schema.json#/$defs/publication_id"
                              },
                              "exchange": {
                                "$ref": "primitives.schema.json#/$defs/exchange_id"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "required": [
                              "kind"
                            ],
                            "properties": {
                              "kind": {
                                "const": "InboundReleased"
                              }
                            }
                          },
                          "then": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "exchange"
                            ],
                            "properties": {
                              "kind": {
                                "const": "InboundReleased"
                              },
                              "exchange": {
                                "$ref": "primitives.schema.json#/$defs/exchange_id"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "required": [
                              "kind"
                            ],
                            "properties": {
                              "kind": {
                                "const": "SubscriptionsChanged"
                              }
                            }
                          },
                          "then": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "session",
                              "route_revision"
                            ],
                            "properties": {
                              "kind": {
                                "const": "SubscriptionsChanged"
                              },
                              "session": {
                                "$ref": "primitives.schema.json#/$defs/u64"
                              },
                              "route_revision": {
                                "$ref": "primitives.schema.json#/$defs/u64"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "required": [
                              "kind"
                            ],
                            "properties": {
                              "kind": {
                                "const": "DeliveryClaimed"
                              }
                            }
                          },
                          "then": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "delivery_id",
                              "target_session",
                              "packet_id",
                              "claim_operation_id"
                            ],
                            "properties": {
                              "kind": {
                                "const": "DeliveryClaimed"
                              },
                              "delivery_id": {
                                "$ref": "primitives.schema.json#/$defs/delivery_id"
                              },
                              "target_session": {
                                "$ref": "primitives.schema.json#/$defs/u64"
                              },
                              "packet_id": {
                                "$ref": "primitives.schema.json#/$defs/packet_id"
                              },
                              "claim_operation_id": {
                                "$ref": "primitives.schema.json#/$defs/operation_id"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "required": [
                              "kind"
                            ],
                            "properties": {
                              "kind": {
                                "const": "DeliveryFinished"
                              }
                            }
                          },
                          "then": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "delivery_id",
                              "target_session",
                              "packet_id",
                              "claim_operation_id"
                            ],
                            "properties": {
                              "kind": {
                                "const": "DeliveryFinished"
                              },
                              "delivery_id": {
                                "$ref": "primitives.schema.json#/$defs/delivery_id"
                              },
                              "target_session": {
                                "$ref": "primitives.schema.json#/$defs/u64"
                              },
                              "packet_id": {
                                "$ref": "primitives.schema.json#/$defs/packet_id"
                              },
                              "claim_operation_id": {
                                "$ref": "primitives.schema.json#/$defs/operation_id"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "RejectedCertain"
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "reason"
                  ],
                  "properties": {
                    "kind": {
                      "const": "RejectedCertain"
                    },
                    "reason": {
                      "enum": [
                        "PreconditionFailed",
                        "CapacityExceeded",
                        "Fenced",
                        "EpochClosed"
                      ]
                    },
                    "resource": {
                      "$ref": "primitives.schema.json#/$defs/name"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "required": [
                          "reason"
                        ],
                        "properties": {
                          "reason": {
                            "const": "CapacityExceeded"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "resource"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "resource"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "maxItems": 65536
    },
    "fences": {
      "description": "Identities fenced without a recipe, by OperationId: definitively not executable.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id"
        ],
        "properties": {
          "operation_id": {
            "$ref": "primitives.schema.json#/$defs/operation_id"
          }
        }
      },
      "maxItems": 65536
    },
    "payloads": {
      "description": "Payload objects, by PayloadId. A payload goes when its last obligation ends.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payload_id",
          "length",
          "sha256",
          "references"
        ],
        "properties": {
          "payload_id": {
            "$ref": "primitives.schema.json#/$defs/payload_id"
          },
          "length": {
            "$ref": "primitives.schema.json#/$defs/u64"
          },
          "sha256": {
            "$ref": "primitives.schema.json#/$defs/sha256"
          },
          "references": {
            "$ref": "primitives.schema.json#/$defs/u64",
            "description": "Live obligations that refer to the payload."
          }
        }
      },
      "maxItems": 65536
    },
    "publications": {
      "description": "Admitted publications, by PublicationId. A publication outlives its payload.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publication_id",
          "operation_id",
          "source_session",
          "topic_hex",
          "qos",
          "retain",
          "payload_id"
        ],
        "properties": {
          "publication_id": {
            "$ref": "primitives.schema.json#/$defs/publication_id"
          },
          "operation_id": {
            "$ref": "primitives.schema.json#/$defs/operation_id"
          },
          "source_session": {
            "$ref": "primitives.schema.json#/$defs/u64"
          },
          "topic_hex": {
            "$ref": "primitives.schema.json#/$defs/hex_bytes"
          },
          "qos": {
            "$ref": "primitives.schema.json#/$defs/qos"
          },
          "retain": {
            "type": "boolean"
          },
          "payload_id": {
            "$ref": "primitives.schema.json#/$defs/payload_id"
          }
        }
      },
      "maxItems": 65536
    },
    "obligations": {
      "description": "Delivery obligations, by DeliveryId (`publication_id`, then `index`).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publication_id",
          "index",
          "session",
          "target_revision",
          "cause",
          "effective_qos",
          "phase"
        ],
        "properties": {
          "publication_id": {
            "$ref": "primitives.schema.json#/$defs/publication_id"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "session": {
            "$ref": "primitives.schema.json#/$defs/u64"
          },
          "target_revision": {
            "$ref": "primitives.schema.json#/$defs/u64"
          },
          "cause": {
            "enum": [
              "LiveExact"
            ]
          },
          "effective_qos": {
            "$ref": "primitives.schema.json#/$defs/qos"
          },
          "phase": {
            "enum": [
              "Queued"
            ]
          }
        }
      },
      "maxItems": 65536
    },
    "inbound_exchanges": {
      "description": "Inbound QoS 2 exchanges that are durably open, by session, then Packet Identifier. A released exchange has no row.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exchange",
          "packet_id",
          "publication_id",
          "phase"
        ],
        "properties": {
          "exchange": {
            "$ref": "primitives.schema.json#/$defs/exchange_id"
          },
          "packet_id": {
            "$ref": "primitives.schema.json#/$defs/packet_id"
          },
          "publication_id": {
            "$ref": "primitives.schema.json#/$defs/publication_id"
          },
          "phase": {
            "enum": [
              "AwaitPubrel"
            ]
          }
        }
      },
      "maxItems": 65536
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used",
        "limits"
      ],
      "properties": {
        "used": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_bytes",
            "references",
            "exchange_slots",
            "receipt_slots"
          ],
          "properties": {
            "payload_bytes": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "references": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "exchange_slots": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "receipt_slots": {
              "$ref": "primitives.schema.json#/$defs/u64"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_bytes",
            "references",
            "exchange_slots",
            "receipt_slots",
            "max_targets_per_admission",
            "max_topic_bytes",
            "max_payload_bytes",
            "max_sessions",
            "max_route_targets"
          ],
          "properties": {
            "payload_bytes": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "references": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "exchange_slots": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "receipt_slots": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "max_targets_per_admission": {
              "$ref": "primitives.schema.json#/$defs/u32"
            },
            "max_topic_bytes": {
              "$ref": "primitives.schema.json#/$defs/u32"
            },
            "max_payload_bytes": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "max_sessions": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "max_route_targets": {
              "$ref": "primitives.schema.json#/$defs/u64"
            }
          }
        }
      }
    },
    "outbound": {
      "description": "Durable outgoing QoS 1 claims, by DeliveryId. MayHaveStarted is a conservative durable emission intent, not proof that bytes reached a client.",
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delivery_id",
          "target_session",
          "target_revision",
          "packet_id",
          "claim_operation_id",
          "phase",
          "emission"
        ],
        "properties": {
          "delivery_id": {
            "$ref": "primitives.schema.json#/$defs/delivery_id"
          },
          "target_session": {
            "$ref": "primitives.schema.json#/$defs/u64"
          },
          "target_revision": {
            "$ref": "primitives.schema.json#/$defs/u64"
          },
          "packet_id": {
            "$ref": "primitives.schema.json#/$defs/packet_id"
          },
          "claim_operation_id": {
            "$ref": "primitives.schema.json#/$defs/operation_id"
          },
          "phase": {
            "const": "AwaitPuback"
          },
          "emission": {
            "const": "MayHaveStarted"
          }
        }
      }
    }
  }
}
