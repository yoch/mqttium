{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mqttiumd primitives",
  "description": "Identities, bounds, encodings and digests shared by every v1 format (DEM-005, DEM-014). Strings that carry numbers or digests also forbid line breaks explicitly, because validators disagree on whether `$` matches before a trailing line break.",
  "$defs": {
    "u64": {
      "description": "Canonical decimal string of an unsigned 64-bit value. The semantic pass also enforces the upper bound 18446744073709551615.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "u32": {
      "description": "Canonical decimal string of an unsigned 32-bit value. The semantic pass also enforces the upper bound 4294967295.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})$",
      "maxLength": 10,
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "packet_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "qos": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ]
    },
    "name": {
      "description": "Lower-case identifier of a catalogue entry, client or checkpoint.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "binding": {
      "description": "A scenario and oracle reference. It is never given to the broker.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "dotted_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 96,
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "type_name": {
      "description": "Name of a variant, state class or effect.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,63}$",
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*[a-z]?$",
      "maxLength": 32,
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "minLength": 4,
      "maxLength": 4
    },
    "hex_bytes": {
      "description": "Exact bytes, two lower-case hexadecimal digits each.",
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "relative_path": {
      "description": "Path relative to the mqttiumd root. The semantic pass refuses `..` segments and absolute paths.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$",
      "maxLength": 255,
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "operation_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incarnation",
        "epoch",
        "owner",
        "sequence"
      ],
      "properties": {
        "incarnation": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "epoch": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "owner": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "sequence": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "publication_id": {
      "description": "One internal publication, independent of any Packet Identifier.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incarnation",
        "epoch",
        "owner",
        "sequence"
      ],
      "properties": {
        "incarnation": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "epoch": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "owner": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "sequence": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "payload_id": {
      "description": "One durable immutable payload object.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incarnation",
        "epoch",
        "owner",
        "sequence"
      ],
      "properties": {
        "incarnation": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "epoch": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "owner": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "sequence": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "effect_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "owner",
        "sequence"
      ],
      "properties": {
        "epoch": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "owner": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "sequence": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "connection_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "generation"
      ],
      "properties": {
        "session": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "generation": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "exchange_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "generation"
      ],
      "properties": {
        "session": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "generation": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "store_outcome": {
      "enum": [
        "Committed",
        "RejectedCertain",
        "PendingOrUnknown",
        "RetiredOutcomeUnavailable",
        "Violation"
      ]
    },
    "store_violation": {
      "description": "The contract violation a store reports instead of an outcome (StoreViolation).",
      "enum": [
        "RecipeMismatch"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "OUT_OF_SCOPE"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "primitives.schema.json#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "primitives.schema.json#/$defs/sha256"
        },
        "bytes": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "reject_reason": {
      "description": "Why the store rejected an operation for certain, in the vocabulary of RejectReason.",
      "enum": [
        "PreconditionFailed",
        "CapacityExceeded",
        "Fenced",
        "EpochClosed",
        "SessionCapacityExceeded"
      ]
    },
    "durableReadCode": {
      "enum": [
        "InvalidData",
        "LimitExceeded",
        "Unavailable",
        "Io",
        "AllocationFailed",
        "FrontierMoved",
        "EmptyPage"
      ]
    },
    "durableReadPhase": {
      "enum": [
        "Open",
        "Ledger",
        "Opening",
        "Lookup",
        "Snapshot",
        "Inspect",
        "Recovery",
        "Work",
        "Maintenance"
      ]
    },
    "processControlCode": {
      "enum": [
        "TruncatedFrame",
        "FrameTooLarge",
        "InvalidFrame",
        "Io",
        "ClosedChannel",
        "DuplicateTermination",
        "ReportBudgetExceeded",
        "ActionDeadlineExceeded",
        "DrainDeadlineExceeded",
        "LateEvidence",
        "LateReport",
        "InvalidOrdering",
        "InvalidParked"
      ]
    },
    "processControlPhase": {
      "enum": [
        "Start",
        "Action",
        "KillDrain",
        "Stop"
      ]
    },
    "delivery_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "index"
      ],
      "properties": {
        "publication_id": {
          "$ref": "primitives.schema.json#/$defs/publication_id"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "receipt_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incarnation",
        "epoch",
        "owner"
      ],
      "properties": {
        "incarnation": {
          "$ref": "#/$defs/u64"
        },
        "epoch": {
          "$ref": "#/$defs/u64"
        },
        "owner": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "receipt_closure": {
      "type": "object",
      "additionalProperties": false,
      "description": "A committed non-execution prefix, not a rejection receipt. Physical rows below the boundary may remain until later bounded sweeps. Identity boundaries are producer issuance guards, never reconstructed from the largest retained admission.",
      "required": [
        "origin",
        "through",
        "publication_through",
        "payload_through"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/receipt_origin"
        },
        "through": {
          "$ref": "#/$defs/u64"
        },
        "publication_through": {
          "$ref": "#/$defs/u64"
        },
        "payload_through": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "session_expiry": {
      "description": "Omitted legacy fixtures mean Never. Finite seconds use an explicit After discriminant; zero and infinity have distinct representations. SQLite schema6 persists and validates every policy.",
      "oneOf": [
        {
          "enum": [
            "OnDisconnect",
            "Never"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "After"
          ],
          "properties": {
            "After": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967294
            }
          }
        }
      ]
    },
    "session_opening": {
      "description": "OperationId of the durable open attachment, or null for a legacy Admin fixture. Omitted legacy JSON means null.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "primitives.schema.json#/$defs/operation_id"
        }
      ]
    },
    "session_cancellations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbound",
        "deliveries",
        "routes"
      ],
      "properties": {
        "inbound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "deliveries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "routes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "session_change": {
      "description": "Known committed lifecycle business facts; cancellation is distinct from successful delivery. The attachment of an Open is its enclosing OperationId.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "session",
            "route_revision",
            "cancelled",
            "revision",
            "session_present",
            "expiry",
            "retired"
          ],
          "properties": {
            "kind": {
              "const": "Opened"
            },
            "session": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "route_revision": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "cancelled": {
              "$ref": "primitives.schema.json#/$defs/session_cancellations"
            },
            "revision": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "session_present": {
              "type": "boolean"
            },
            "expiry": {
              "$ref": "primitives.schema.json#/$defs/session_expiry"
            },
            "retired": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "primitives.schema.json#/$defs/u64"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "session",
            "route_revision",
            "cancelled"
          ],
          "properties": {
            "kind": {
              "const": "Closed"
            },
            "session": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "route_revision": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "cancelled": {
              "$ref": "primitives.schema.json#/$defs/session_cancellations"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "session",
            "expiry",
            "detached"
          ],
          "properties": {
            "kind": {
              "const": "Detached"
            },
            "session": {
              "$ref": "primitives.schema.json#/$defs/u64"
            },
            "expiry": {
              "$ref": "primitives.schema.json#/$defs/session_expiry"
            },
            "detached": {
              "$ref": "primitives.schema.json#/$defs/session_detachment"
            }
          }
        }
      ]
    },
    "session_detachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "deadline"
      ],
      "properties": {
        "operation": {
          "$ref": "primitives.schema.json#/$defs/operation_id"
        },
        "deadline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "primitives.schema.json#/$defs/u64"
            }
          ]
        }
      },
      "description": "One immutable durable offline occurrence; deadline is logical nanoseconds, or null for retained infinity. Omission/null in legacy Session JSON means no durable detachment."
    },
    "session_detachment_optional": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "primitives.schema.json#/$defs/session_detachment"
        }
      ]
    },
    "session_clock_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading",
        "logical"
      ],
      "properties": {
        "reading": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "tick"
          ],
          "properties": {
            "domain": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "tick": {
              "$ref": "primitives.schema.json#/$defs/u64"
            }
          }
        },
        "logical": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      },
      "description": "The one overwritable BOOTTIME anchor. A changed/unproven domain preserves committed logical progress and does not invent downtime. UTC is not an expiry authority."
    },
    "subscription_options": {
      "description": "MQTT5 subscription option bits excluding QoS: No Local, RAP and RH0/1/2. Missing on historical route evidence means0; writers omit0.",
      "type": "integer",
      "enum": [
        0,
        4,
        8,
        12,
        16,
        20,
        24,
        28,
        32,
        36,
        40,
        44
      ]
    }
  }
}
