{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mqttiumd run manifest",
  "description": "Exact content and configuration of one run (DEM-003, V3-002). Lot L0 fills the content sections; the experiment sections become required with the lots that produce them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "product",
    "toolchain",
    "build",
    "contracts",
    "platform"
  ],
  "properties": {
    "format": {
      "const": "mqttiumd.run-manifest"
    },
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "tree_state",
        "modified_paths"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_state": {
          "enum": [
            "clean",
            "modified"
          ]
        },
        "modified_paths": {
          "type": "array",
          "items": {
            "$ref": "primitives.schema.json#/$defs/text"
          },
          "maxItems": 4096
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rustc",
        "cargo",
        "host"
      ],
      "properties": {
        "rustc": {
          "$ref": "primitives.schema.json#/$defs/text"
        },
        "cargo": {
          "$ref": "primitives.schema.json#/$defs/text"
        },
        "host": {
          "$ref": "primitives.schema.json#/$defs/text"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "target",
        "lockfile_sha256",
        "workspace_manifest_sha256"
      ],
      "properties": {
        "profile": {
          "enum": [
            "debug",
            "release"
          ]
        },
        "target": {
          "$ref": "primitives.schema.json#/$defs/text"
        },
        "lockfile_sha256": {
          "$ref": "primitives.schema.json#/$defs/sha256"
        },
        "workspace_manifest_sha256": {
          "$ref": "primitives.schema.json#/$defs/sha256"
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "primitives.schema.json#/$defs/artifact"
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch"
      ],
      "properties": {
        "os": {
          "$ref": "primitives.schema.json#/$defs/text"
        },
        "arch": {
          "$ref": "primitives.schema.json#/$defs/text"
        }
      }
    },
    "scenario": {
      "$ref": "primitives.schema.json#/$defs/artifact"
    },
    "fixture": {
      "$ref": "primitives.schema.json#/$defs/artifact"
    },
    "backend": {
      "enum": [
        "sim-store",
        "sqlite"
      ]
    },
    "failure_model": {
      "enum": [
        "none",
        "process"
      ]
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "seed"
      ],
      "properties": {
        "version": {
          "$ref": "primitives.schema.json#/$defs/u64"
        },
        "seed": {
          "$ref": "primitives.schema.json#/$defs/u64"
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "primitives.schema.json#/$defs/text"
      },
      "maxItems": 64
    }
  }
}
