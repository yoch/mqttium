{
  "format": "mqttiumd.scenario",
  "schema_version": 1,
  "id": "P1-02b",
  "profile": "p1-durable-mqtt5-without-expiry",
  "initial_fixture": "tests/fixtures/p1/three-persistent-sessions.json",
  "budgets": {
    "max_steps": "4096",
    "max_trace_bytes": "16777216"
  },
  "faults": [
    {
      "id": "held_admission",
      "point": "store.command.transit",
      "match": {
        "command_kind": "AdmitPublication",
        "publication_binding": "pub_A"
      },
      "occurrence": "1",
      "action": "hold_command",
      "bind_operation_as": "op_A",
      "expected_hits": "1"
    },
    {
      "id": "held_unknown",
      "point": "store.result.ready",
      "match": {
        "command_kind": "AdmitPublication",
        "publication_binding": "pub_A",
        "result_of": "ResolveAndFence"
      },
      "occurrence": "1",
      "action": "delay_result",
      "expected_hits": "1"
    },
    {
      "id": "lost_admission_result",
      "point": "store.result.ready",
      "match": {
        "command_kind": "AdmitPublication",
        "publication_binding": "pub_A",
        "result_of": "Persist"
      },
      "occurrence": "1",
      "action": "drop_result",
      "expected_hits": "1"
    }
  ],
  "steps": [
    {
      "kind": "ClientResumeSession",
      "client": "producer",
      "expect_session_present": true,
      "max_steps": "512"
    },
    {
      "kind": "ClientPublish",
      "client": "producer",
      "topic": "p1/example",
      "qos": 2,
      "retain": false,
      "packet_id": 7,
      "payload_hex": "7061796c6f6164",
      "bind_exchange_as": "pub_A"
    },
    {
      "kind": "DriveUntil",
      "event": "FaultHit",
      "binding": "held_admission",
      "max_steps": "512"
    },
    {
      "kind": "FireDeadline",
      "max_steps": "8192"
    },
    {
      "kind": "DriveUntil",
      "event": "FaultHit",
      "binding": "held_unknown",
      "max_steps": "512"
    },
    {
      "kind": "ReleaseHeldCommand",
      "fault": "held_admission"
    },
    {
      "kind": "DriveUntil",
      "event": "FaultHit",
      "binding": "lost_admission_result",
      "max_steps": "512"
    },
    {
      "kind": "InspectDurableState",
      "checkpoint": "after_commit"
    },
    {
      "kind": "FireDeadline",
      "max_steps": "512"
    },
    {
      "kind": "DriveUntil",
      "event": "PeerPacketObserved",
      "client": "producer",
      "packet_kind": "PUBREC",
      "packet_id": 7,
      "max_steps": "512"
    },
    {
      "kind": "DeliverHeldResult",
      "fault": "held_unknown",
      "max_steps": "512"
    },
    {
      "kind": "ClientSendPubrel",
      "client": "producer",
      "packet_id": 7
    },
    {
      "kind": "DriveUntil",
      "event": "PeerPacketObserved",
      "client": "producer",
      "packet_kind": "PUBCOMP",
      "packet_id": 7,
      "max_steps": "512"
    },
    {
      "kind": "InspectDurableState",
      "checkpoint": "final"
    }
  ],
  "assertions": [
    "one_admission_per_observed_inbound_exchange",
    "same_required_obligations_at_both_checkpoints",
    "same_recipe_for_op_A",
    "no_positive_ack_before_confirmed_commit",
    "all_required_faults_hit",
    "trace_complete"
  ]
}
